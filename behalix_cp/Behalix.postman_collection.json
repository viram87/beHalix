{
  "info": {
    "_postman_id": "behalix-event-rsvp-platform",
    "name": "Behalix Event RSVP Platform",
    "description": "Complete API collection for the Behalix Event RSVP Platform.\n\n**Workflow:**\n1. Run Signup (generates random email)\n2. Verify Email (requires the OTP code from email/console)\n3. Login (auto-sets authToken and userId)\n4. Create Event (auto-sets eventId)\n5. Use remaining endpoints freely\n\nAll protected endpoints use the `authToken` collection variable set by the Login request.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000",
      "type": "string"
    },
    {
      "key": "authToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "eventId",
      "value": "",
      "type": "string"
    },
    {
      "key": "userId",
      "value": "",
      "type": "string"
    },
    {
      "key": "testEmail",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Auth",
      "description": "User authentication and registration endpoints",
      "item": [
        {
          "name": "Signup",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set(\"testEmail\", \"test+\" + Date.now() + \"@example.com\");"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 201\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "pm.test(\"Response contains message and email\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.have.property(\"message\");",
                  "    pm.expect(jsonData).to.have.property(\"email\");",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{testEmail}}\",\n  \"password\": \"SecurePass1\",\n  \"gender\": \"female\",\n  \"interests\": [\"music\", \"technology\", \"hiking\"]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/signup",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "signup"]
            },
            "description": "Register a new user. A pre-request script generates a unique email address to avoid duplicate errors. An OTP verification code will be sent to the email (check console logs in dev mode)."
          },
          "response": []
        },
        {
          "name": "Verify Email",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Response contains success message\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.have.property(\"message\");",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{testEmail}}\",\n  \"code\": \"123456\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/verify-email",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "verify-email"]
            },
            "description": "Verify user email with the 6-digit OTP code. Replace the code value with the actual OTP received via email or console log."
          },
          "response": []
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Response contains token and user\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.have.property(\"token\");",
                  "    pm.expect(jsonData).to.have.property(\"user\");",
                  "    pm.expect(jsonData.user).to.have.property(\"id\");",
                  "});",
                  "",
                  "var jsonData = pm.response.json();",
                  "if (jsonData.token) {",
                  "    pm.collectionVariables.set(\"authToken\", jsonData.token);",
                  "}",
                  "if (jsonData.user && jsonData.user.id) {",
                  "    pm.collectionVariables.set(\"userId\", jsonData.user.id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{testEmail}}\",\n  \"password\": \"SecurePass1\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "login"]
            },
            "description": "Login with email and password. On success, the test script automatically sets the `authToken` and `userId` collection variables for use in subsequent requests."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Users",
      "description": "User profile management endpoints (all require authentication)",
      "item": [
        {
          "name": "Get Me",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Response contains user profile fields\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.have.property(\"id\");",
                  "    pm.expect(jsonData).to.have.property(\"email\");",
                  "    pm.expect(jsonData).to.have.property(\"gender\");",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/users/me",
              "host": ["{{baseUrl}}"],
              "path": ["users", "me"]
            },
            "description": "Get the currently authenticated user's profile including email, gender, interests, and creation date."
          },
          "response": []
        },
        {
          "name": "Update Profile",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Response contains updated profile\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.have.property(\"message\");",
                  "    pm.expect(jsonData).to.have.property(\"profile\");",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"gender\": \"female\",\n  \"interests\": [\"yoga\", \"cooking\", \"photography\"]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/users/me/profile",
              "host": ["{{baseUrl}}"],
              "path": ["users", "me", "profile"]
            },
            "description": "Update the authenticated user's profile. Both fields are optional — send only what you want to change. Gender must be one of: male, female, other. Max 10 interests, each max 50 chars."
          },
          "response": []
        },
        {
          "name": "Get My RSVPs",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Response contains rsvps array and pagination\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.have.property(\"rsvps\");",
                  "    pm.expect(jsonData.rsvps).to.be.an(\"array\");",
                  "    pm.expect(jsonData).to.have.property(\"pagination\");",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/users/me/rsvps?page=1&limit=20",
              "host": ["{{baseUrl}}"],
              "path": ["users", "me", "rsvps"],
              "query": [
                {
                  "key": "page",
                  "value": "1",
                  "description": "Page number (default: 1)"
                },
                {
                  "key": "limit",
                  "value": "20",
                  "description": "Items per page (default: 20, max: 100)"
                }
              ]
            },
            "description": "Get all RSVPs made by the authenticated user, with event details. Supports pagination via page and limit query params."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Events",
      "description": "Event management endpoints (all require authentication)",
      "item": [
        {
          "name": "Create Event",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 201\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "pm.test(\"Response contains event with _id\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.have.property(\"_id\");",
                  "});",
                  "",
                  "var jsonData = pm.response.json();",
                  "if (jsonData._id) {",
                  "    pm.collectionVariables.set(\"eventId\", jsonData._id);",
                  "}"
                ]
              }
            },
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Set a future timestamp (7 days from now)",
                  "var futureDate = new Date();",
                  "futureDate.setDate(futureDate.getDate() + 7);",
                  "pm.collectionVariables.set(\"futureTimestamp\", futureDate.toISOString());"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "title",
                  "value": "Weekend Hiking Adventure",
                  "type": "text"
                },
                {
                  "key": "description",
                  "value": "Join us for a scenic hike through the local trails. All skill levels welcome!",
                  "type": "text"
                },
                {
                  "key": "timestamp",
                  "value": "{{futureTimestamp}}",
                  "type": "text"
                },
                {
                  "key": "isWomenOnly",
                  "value": "false",
                  "type": "text"
                },
                {
                  "key": "address",
                  "value": "{\"line1\":\"123 Trail Head Rd\",\"line2\":\"Suite 4\",\"city\":\"San Francisco\",\"state\":\"CA\",\"zipCode\":\"94102\"}",
                  "type": "text"
                },
                {
                  "key": "images",
                  "type": "file",
                  "src": [],
                  "description": "Optional event images (max 5 files)"
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/events",
              "host": ["{{baseUrl}}"],
              "path": ["events"]
            },
            "description": "Create a new event using multipart/form-data. The `address` field must be a JSON string. The `timestamp` must be an ISO 8601 date in the future (auto-generated by pre-request script). The `images` field accepts up to 5 image files. On success, the test script saves the event ID to `eventId`."
          },
          "response": []
        },
        {
          "name": "List Events",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Response contains events array and pagination\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.have.property(\"events\");",
                  "    pm.expect(jsonData.events).to.be.an(\"array\");",
                  "    pm.expect(jsonData).to.have.property(\"pagination\");",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/events?page=1&limit=20",
              "host": ["{{baseUrl}}"],
              "path": ["events"],
              "query": [
                {
                  "key": "page",
                  "value": "1",
                  "description": "Page number (default: 1)"
                },
                {
                  "key": "limit",
                  "value": "20",
                  "description": "Items per page (default: 20, max: 100)"
                },
                {
                  "key": "lat",
                  "value": "37.7749",
                  "description": "Latitude for location-based search",
                  "disabled": true
                },
                {
                  "key": "lng",
                  "value": "-122.4194",
                  "description": "Longitude for location-based search",
                  "disabled": true
                },
                {
                  "key": "radius",
                  "value": "10",
                  "description": "Search radius in km (default: 10)",
                  "disabled": true
                }
              ]
            },
            "description": "Get a paginated list of events. Male users will not see women-only events. Optional location-based filtering via lat, lng, and radius query params (disabled by default — enable to use)."
          },
          "response": []
        },
        {
          "name": "Get Event",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Response contains event details\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.have.property(\"_id\");",
                  "    pm.expect(jsonData).to.have.property(\"title\");",
                  "    pm.expect(jsonData).to.have.property(\"rsvpCount\");",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/events/{{eventId}}",
              "host": ["{{baseUrl}}"],
              "path": ["events", "{{eventId}}"]
            },
            "description": "Get details for a specific event by ID. Returns the event object with an rsvpCount field. Male users cannot access women-only events."
          },
          "response": []
        },
        {
          "name": "Delete Event",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Response contains success message\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.have.property(\"message\");",
                  "    pm.expect(jsonData.message).to.eql(\"Event deleted successfully\");",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/events/{{eventId}}",
              "host": ["{{baseUrl}}"],
              "path": ["events", "{{eventId}}"]
            },
            "description": "Delete an event by ID. Only the event creator can delete their own events. Also deletes all associated RSVPs."
          },
          "response": []
        }
      ]
    },
    {
      "name": "RSVPs",
      "description": "Event RSVP management endpoints (all require authentication)",
      "item": [
        {
          "name": "RSVP to Event",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 201\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "pm.test(\"Response contains RSVP details\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.have.property(\"message\");",
                  "    pm.expect(jsonData).to.have.property(\"rsvp\");",
                  "    pm.expect(jsonData.rsvp).to.have.property(\"id\");",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/events/{{eventId}}/rsvp",
              "host": ["{{baseUrl}}"],
              "path": ["events", "{{eventId}}", "rsvp"]
            },
            "description": "RSVP to an event. No request body needed — just POST to the endpoint. Returns 409 if already RSVPed. Male users cannot RSVP to women-only events."
          },
          "response": []
        },
        {
          "name": "Cancel RSVP",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Response contains success message\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.have.property(\"message\");",
                  "    pm.expect(jsonData.message).to.eql(\"RSVP cancelled successfully\");",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/events/{{eventId}}/rsvp",
              "host": ["{{baseUrl}}"],
              "path": ["events", "{{eventId}}", "rsvp"]
            },
            "description": "Cancel your RSVP to an event. Returns 404 if no RSVP exists for this user and event."
          },
          "response": []
        },
        {
          "name": "Get Event RSVPs",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Response contains rsvps array\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.have.property(\"rsvps\");",
                  "    pm.expect(jsonData.rsvps).to.be.an(\"array\");",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/events/{{eventId}}/rsvps?page=1&limit=50",
              "host": ["{{baseUrl}}"],
              "path": ["events", "{{eventId}}", "rsvps"],
              "query": [
                {
                  "key": "page",
                  "value": "1",
                  "description": "Page number (default: 1)"
                },
                {
                  "key": "limit",
                  "value": "50",
                  "description": "Items per page (default: 50, max: 100)"
                },
                {
                  "key": "all",
                  "value": "false",
                  "description": "Set to 'true' to return all RSVPs without pagination",
                  "disabled": true
                }
              ]
            },
            "description": "Get all RSVPs for a specific event. Returns user details (email, gender, interests) for each RSVP. Supports pagination via page/limit, or set all=true to get everything at once."
          },
          "response": []
        }
      ]
    }
  ]
}
